_raspiBackupConfig() {
    # shellcheck disable=SC2034 # words and cword are set by _init_completion
    local cur prev words cword
    if declare -F _init_completion > /dev/null; then
        _init_completion || return
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    fi

    if [[ "$prev" == "-t" ]]; then
        mapfile -t COMPREPLY < <(compgen -W "crond systemd" -- "$cur")
        return
    fi

    if [[ "$cur" == -* || -z "$cur" ]]; then
        local options="-f -h -s -t --version" w
        # the modes exclude each other, offer them only if none was given yet
        local modes="-b -i -m -R -S -u -U"
        for w in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
            case "$w" in
                -*[bimRSuU]*) [[ "$w" != --* ]] && modes="" ;;
            esac
        done
        mapfile -t COMPREPLY < <(compgen -W "$options $modes" -- "$cur")
    fi
}

complete -F _raspiBackupConfig raspiBackupConfig raspiBackupConfig.sh raspiBackupInstallUI
