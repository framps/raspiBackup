#!/bin/bash
# vim: set expandtab:
#
# preinst of ${PACKAGE_NAME}
#
# raspiBackup installed without apt (raspiBackupInstallUI.sh, install.sh) is migrated to the package.
# dpkg overwrites its raspiBackup.sh and raspiBackupInstallUI.sh and postrm deletes its timer when the
# package is removed. So save the former installation before dpkg unpacks the package and create
# revertMigration.sh, which restores it without the package and without network access.
# The backup isn't in /var/lib/raspiBackup, purge deletes that.

set -euo pipefail

LEGACY_DIR="/var/backups/raspiBackup-legacy"

save() { # file - copies a regular file (no link) with its path into the backup
    if [[ -f "$1" && ! -L "$1" ]]; then
        mkdir -p "$LEGACY_DIR/files$(dirname "$1")"
        cp -a "$1" "$LEGACY_DIR/files$1"
    fi
}

case "${1:-}" in
    install)
        # a link means it's the package's raspiBackup.sh, e.g. a reinstall after remove
        if [[ -f "${DIR_BIN}/raspiBackup.sh" && ! -L "${DIR_BIN}/raspiBackup.sh" ]]; then
            echo "Saving the installation of raspiBackup without apt in $LEGACY_DIR"
            rm -rf "$LEGACY_DIR"
            install -d -m 700 "$LEGACY_DIR"

            save "${DIR_BIN}/raspiBackup.sh"
            save "${DIR_BIN}/raspiBackupInstallUI.sh"
            for extension in "${DIR_BIN}"/raspiBackup_*.sh; do
                save "$extension"
            done
            save "${DIR_ETC}/raspiBackup.conf"
            save /etc/systemd/system/raspiBackup.service
            save /etc/systemd/system/raspiBackup.timer
            save /etc/cron.d/raspiBackup
            if [[ -d /run/systemd/system ]] && systemctl -q is-enabled raspiBackup.timer 2> /dev/null; then
                touch "$LEGACY_DIR/timer.enabled"
            fi

            cat > "$LEGACY_DIR/revertMigration.sh" <<'EOF_REVERT'
#!/bin/bash
#
# Reverts the migration of raspiBackup to the Debian package ${PACKAGE_NAME}:
# removes the package and its apt repository and restores the former installation without apt
# (code, installer, configuration, extensions and backup timer) saved in this directory.
#
# Usage: sudo revertMigration.sh [-y]     -y: don't ask

set -uo pipefail

LEGACY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FILES="$LEGACY_DIR/files"
CONFIG="${DIR_ETC}/raspiBackup.conf"

if (( EUID != 0 )); then
    echo "Root access required. Use 'sudo $0'"
    exit 1
fi

if [[ ! -f "$FILES${DIR_BIN}/raspiBackup.sh" ]]; then
    echo "??? No saved installation found in $FILES"
    exit 1
fi

version="$(grep -m1 -oP '^VERSION="\K[^"]*' "$FILES${DIR_BIN}/raspiBackup.sh" || true)"
echo "Reverting raspiBackup to version ${version:-unknown} installed without apt, saved in $LEGACY_DIR"
if [[ "${1:-}" != "-y" ]]; then
    read -r -p "The package ${PACKAGE_NAME} and its apt repository are removed. Continue? (y/N) " answer
    [[ "$answer" =~ ^[yYjJ] ]] || exit 1
fi

# remove, not purge: purge deletes the configuration. postrm deletes the timers and the links of the extensions
if dpkg-query -W -f '${Status}' ${PACKAGE_NAME} 2> /dev/null | grep -q " installed$"; then
    echo "--- Removing package ${PACKAGE_NAME}"
    apt-mark unhold ${PACKAGE_NAME} > /dev/null 2>&1
    if ! apt-get remove -y ${PACKAGE_NAME}; then
        echo "??? apt-get remove ${PACKAGE_NAME} failed, nothing restored"
        exit 1
    fi
fi

echo "--- Removing the apt repository of ${PACKAGE_NAME}"
rm -f /etc/apt/sources.list.d/${PACKAGE_NAME}.sources /usr/share/keyrings/${PACKAGE_NAME}-archive-keyring.gpg

rc=0
restore() { # file
    [[ -f "$FILES$1" ]] || return 0
    echo "--- Restoring $1"
    rm -f "$1"
    mkdir -p "$(dirname "$1")"
    cp -a "$FILES$1" "$1" || rc=1
}

restore "${DIR_BIN}/raspiBackup.sh"
ln -sfn raspiBackup.sh "${DIR_BIN}/raspiBackup" || rc=1
if [[ -f "$FILES${DIR_BIN}/raspiBackupInstallUI.sh" ]]; then
    restore "${DIR_BIN}/raspiBackupInstallUI.sh"
    ln -sfn raspiBackupInstallUI.sh "${DIR_BIN}/raspiBackupInstallUI" || rc=1
fi

for extension in "$FILES${DIR_BIN}"/raspiBackup_*.sh; do
    [[ -f "$extension" ]] && restore "${extension#"$FILES"}"
done

if [[ -f "$FILES$CONFIG" ]]; then
    # the package added new options, keep that configuration too
    [[ -f "$CONFIG" ]] && cp -a "$CONFIG" "$CONFIG.package" && echo "--- Configuration of the package saved as $CONFIG.package"
    restore "$CONFIG"
fi

restore /etc/cron.d/raspiBackup
restore /etc/systemd/system/raspiBackup.service
restore /etc/systemd/system/raspiBackup.timer
if [[ -d /run/systemd/system ]]; then
    systemctl daemon-reload
    if [[ -f "$LEGACY_DIR/timer.enabled" ]]; then
        echo "--- Enabling raspiBackup.timer"
        systemctl enable --now raspiBackup.timer || rc=1
    fi
fi

if (( rc )); then
    echo "??? Not all files could be restored, see the messages above"
else
    echo "--- raspiBackup ${version} without apt restored"
    echo "--- To migrate to the package again use: curl -fsSL https://framps.github.io/raspiBackup/raspiBackupInstall.sh | bash"
fi
exit $rc
EOF_REVERT
            chmod 700 "$LEGACY_DIR/revertMigration.sh"
            echo "Revert the migration to the package with: sudo $LEGACY_DIR/revertMigration.sh"
        fi
        ;;
esac

exit 0
