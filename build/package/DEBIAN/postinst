#!/bin/bash
# vim: set expandtab:
#
# postinst of ${PACKAGE_NAME}
#
# The configuration ${DIR_ETC}/raspiBackup.conf is created from a template on first installation only.
# It's no conffile, so dpkg never touches it. raspiBackupInstallUI and 'raspiBackup --updateConfig' update it.

set -euo pipefail

CONFIG="${DIR_ETC}/raspiBackup.conf"
TEMPLATES="${DIR_SHARE}/${PACKAGE_NAME}"

case "${1:-}" in
    configure)
        if [[ -f "$CONFIG" ]]; then
            echo "Keeping existing configuration $CONFIG, saved as $CONFIG~"
            cp -a "$CONFIG" "$CONFIG~"
        else
            # use German config file, English is default
            lang="${LANG:-}"
            template="$TEMPLATES/raspiBackup_en.conf"
            if [[ "${lang:0:2}" == "de" ]]; then
                template="$TEMPLATES/raspiBackup_de.conf"
            fi
            echo "Creating configuration $CONFIG from $template"
            install -m 600 "$template" "$CONFIG"
        fi
        # config may contain sensitive information like pwds, keys et al
        chmod 600 "$CONFIG"

        if [[ -d /run/systemd/system ]]; then
            systemctl daemon-reload || true
        fi

        echo "Configure raspiBackup with: sudo raspiBackupInstallUI"
        ;;
esac

exit 0
